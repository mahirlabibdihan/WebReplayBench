# Connection string for the playground database. The database is created by
# `npm run db:init` if it does not exist; only schemas "app" and "meta" in it
# are ever dropped.
DATABASE_URL=postgres://postgres:<password>@localhost:5432/playground

# Public app (what the agent browses) and the admin/oracle API (reset, ground
# truth). Keep the admin API on a different port than the app, so an agent that
# is only allowed to browse the app's host:port can never reach it.
PORT=4000
ADMIN_PORT=4001
ADMIN_HOST=127.0.0.1

# Test login used by the benchmark tasks (seeded in db/seed.sql).
PLAYGROUND_USER=jordan
PLAYGROUND_PASSWORD=playground123
